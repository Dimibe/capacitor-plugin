{
  "version": "2.1.0",
  "author": "Masahiko Sakakibara <sakakibara@rdlabo.jp>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webview-native-ui/capacitor-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/webview-native-ui/capacitor-plugin/issues"
  },
  "type": "module",
  "name": "@rdlabo/capacitor-native-ui",
  "description": "Web-owned native UI projection for Capacitor",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "ios",
    "android"
  ],
  "main": "./dist/plugin.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/plugin.cjs"
    },
    "./vertical-bars": {
      "types": "./dist/esm/vertical-bars.d.ts",
      "import": "./dist/esm/vertical-bars.js"
    },
    "./integration": {
      "types": "./dist/esm/native-integration/index.d.ts",
      "import": "./dist/esm/native-integration/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/esm/core.d.ts",
      "import": "./dist/esm/core.js"
    }
  },
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "src/",
    "ios/Sources",
    "ios/Tests",
    "Package.swift",
    "RdlaboCapacitorNativeUi.podspec",
    "LICENSE",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "test": "vitest run",
    "test:packages": "node scripts/verify-packages.mjs",
    "test:esm": "node scripts/verify-packages.mjs --esm",
    "lint": "prettier --check \"./**/*.{scss,ts,md}\" && prettier --parser angular --check \"./**/*.html\"",
    "fmt": "prettier --write \"./**/*.{scss,ts,md}\" && prettier --parser angular --write \"./**/*.html\"",
    "release": "np --no-tests --no-publish --branch main",
    "clean": "rm -rf dist",
    "docgen": "docgen --project tsconfig.docgen.json --api NativeUIHandle --output-readme docs/native-ui.md && docgen --project tsconfig.docgen.json --api VerticalControlAreaHandle --output-readme docs/vertical-bars.md",
    "prepublishOnly": "npm run build",
    "watch": "tsc --watch",
    "verify:web": "npm run build && npm test && npm run test:esm"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9",
    "@ionic/core": ">=8.8.1 <10"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "peerDependenciesMeta": {
    "@ionic/core": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@rdlabo/ionic-theme-utils": "0.1.5",
    "@webview-native-ui/engine": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.2",
    "@rdlabo/capacitor-docgen": "^0.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "np": "^10.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "esbuild": "0.28.1",
    "@ionic/core": "8.8.19",
    "@capacitor/ios": "^8.5.2",
    "vitest": "^4.0.0",
    "jsdom": "^26.0.0",
    "rollup": "^4.53.2",
    "@rollup/plugin-node-resolve": "^16.0.0"
  },
  "unpkg": "./dist/plugin.js"
}
